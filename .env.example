# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=pdfusion
POSTGRES_PASSWORD=pdfusion_secret
POSTGRES_DB=pdfusion
DATABASE_URL=postgresql://pdfusion:pdfusion_secret@postgres:5432/pdfusion

# ─── Redis / Celery ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── JWT ─────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ─── File Storage ────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=/app/storage/uploads
PROCESSED_DIR=/app/storage/processed
FILE_EXPIRY_HOURS=24
MAX_FILE_SIZE_MB=100

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ─── AI Provider ─────────────────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key

# ─── Cloud Storage (optional, for production) ────────────────────────────────
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=pdfusion-files
# R2_PUBLIC_URL=https://files.youromain.com

# ─── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
